# ─── Neon Postgres (REQUIRED) ───────────────────────────────────────────────
# Connection string for your Neon database (pooled endpoint recommended).
# Get this from: Neon Console → Your Project → Connection Details → Pooled connection
#
# Format: postgres://<user>:<password>@<endpoint-pooler>.neon.tech/<database>?sslmode=require
#
# Where to set this:
#   • Vercel: Project Settings → Environment Variables → Add DATABASE_URL
#   • Local:  Copy this file to .env.local and fill in the value
#   • Cursor Cloud Agents: Dashboard → Secrets → Add DATABASE_URL
# ────────────────────────────────────────────────────────────────────────────
DATABASE_URL=
